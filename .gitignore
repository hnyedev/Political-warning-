# ── Secrets & local env ──────────────────────────────────────
.env
.env.*
!.env.example

# ── Python runtime ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
*.manifest
*.spec

# Virtual environments (heavy — never commit)
.venv/
venv/
ENV/
env/

# Test / lint / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE & OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs & temp ──────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.cache/

# ── ML / HF / model artifacts (heavy) ────────────────────────
models/
checkpoints/
weights/
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib
*.safetensors
wandb/
mlruns/

# HuggingFace & dataset caches (re-download on setup)
.huggingface/
huggingface/
**/datasets_cache/
**/.cache/huggingface/

# ── Generated data (reproducible from pipeline) ────────────────
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

data/synthetic_graph/*
!data/synthetic_graph/.gitkeep
!data/synthetic_graph/README.md

# ── Generated reports ────────────────────────────────────────
reports/*
!reports/.gitkeep
!reports/README.md
